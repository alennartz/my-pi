{
  "name": "alenna-pi",
  "version": "0.1.0",
  "description": "My personal pi coding agent package containing skills and other things.",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ],
    "themes": [
      "./themes"
    ],
    "agents": [
      "./agents"
    ]
  },
  "devDependencies": {
    "@cloudflare/oxlint-config": "^0.2.0",
    "@earendil-works/pi-agent-core": "^1.6.1",
    "@earendil-works/pi-ai": "^1.6.1",
    "@earendil-works/pi-coding-agent": "^1.6.1",
    "@earendil-works/pi-tui": "^1.6.1",
    "husky": "^9.1.7",
    "oxlint": "^1.95.0",
    "tsrs": "^7.1.0-beta.tsrs2",
    "tsx": "^4.21.0",
    "typebox": "^1.4.2",
    "vitest": "^4.1.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@pimote/sdk": "0.16.0-rc.12",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "link:pimote-sdk": "node ./scripts/link-pimote-sdk.mjs",
    "hooks:install": "husky",
    "lint": "oxlint ."
  }
}
