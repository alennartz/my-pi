{
	"compilerOptions": {
		"target": "esnext",
		"lib": ["esnext", "dom"],
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"types": ["node"]
	},
	"include": ["extensions/**/*.ts", "lib/**/*.ts", "types/**/*.d.ts"],
	"exclude": ["**/*.test.ts"]
}
